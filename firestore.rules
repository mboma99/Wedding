rules_version = '2';

// Every read and write goes through the Next.js server with the Admin SDK,
// which bypasses these rules. No client ever talks to Firestore directly, so
// direct access is denied outright.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
